# Copie para ".env" na raiz de area-verde-api (ao lado de docker-compose.prod.yml)
# antes de rodar "docker compose -f docker-compose.prod.yml up --build -d".
# Nunca commite o ".env" real.

# Troque por uma senha forte de verdade. Sem valor aqui, a propria imagem do
# postgres se recusa a iniciar (ver logs com "docker compose ... logs db").
POSTGRES_PASSWORD=

POSTGRES_USER=area_verde
POSTGRES_DB=area_verde

# Interface em que o frontend fica exposto. O padrao (127.0.0.1) NAO expoe
# nada, nem pra rede local nem pra internet -- so a propria maquina acessa.
#
# - Notebook do bar: pode deixar 127.0.0.1 e acessar via Tailscale/SSH tunnel,
#   ou trocar por 0.0.0.0 se o acesso pretendido e so a rede Wi-Fi local
#   fechada do bar (ver docs/workflows/deploy-onpremise-windows.md).
# - VPS: troque pelo IP Tailscale da propria maquina (rode "tailscale ip -4"
#   depois de instalar o Tailscale) para que SOMENTE dispositivos da sua
#   rede Tailscale consigam acessar. Nunca use 0.0.0.0 numa VPS -- o Docker
#   ignora regras de firewall (ufw) para portas que ele mesmo publica, entao
#   0.0.0.0 significa exposto na internet de verdade, sem senha por usuario
#   e sem limite de tentativas de login.
BIND_HOST=127.0.0.1

# Porta em que o frontend fica exposto dentro de BIND_HOST.
FRONTEND_PORT=80

RUN_MIGRATIONS=true
LOG_LEVEL=INFO

# Same-origin (nginx faz proxy de /api) cobre o uso normal do navegador.
# So precisa de mais origens aqui se algo chamar a API diretamente.
CORS_ALLOW_ORIGINS=http://localhost,http://127.0.0.1

VITE_API_BASE_URL=/api
VITE_APP_NAME=Area Verde
